<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox inheritance for sandboxed parent distribution.
         ONLY use this file when the PARENT app is sandboxed.
         Declare all sandbox capabilities on the parent; this helper adds
         none. If the parent is NOT sandboxed, the worker gets a default
         restrictive sandbox that blocks Python file access.
         The worker binary must have an embedded CFBundleIdentifier
         (via ld -sectcreate __TEXT __info_plist WorkerInfo.plist)
         or libsystem_secinit will crash during dyld init. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
    <!-- Hardened-runtime exception, not a sandbox capability; the parent
         template carries the same key. x86_64 libffi maps ctypes callback
         trampolines writable and executable; without it the worker's first
         callback never returns on Intel. Apple's inherited-helper guidance
         lists only the two keys above, so Mac App Store builds should host
         Python in the ExtensionFoundation worker instead. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
