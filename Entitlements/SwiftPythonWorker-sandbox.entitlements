<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox inheritance for sandboxed parent distribution.
         ONLY use this file when the PARENT app is sandboxed.
         Apple requires an inherited command-line helper to carry only
         app-sandbox and inherit. Declare all capabilities on the parent.
         If the parent is NOT sandboxed, the worker gets a default
         restrictive sandbox that blocks Python file access.
         The worker binary must have an embedded CFBundleIdentifier
         (via ld -sectcreate __TEXT __info_plist WorkerInfo.plist)
         or libsystem_secinit will crash during dyld init. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
