<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- REQUIRED: Hardened-runtime microphone prompting and App Sandbox both
         require the parent application to carry the audio-input capability. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Hardened-runtime exceptions for the supplied Python runtime.
         Re-sign bundled native code with your application's identity.
         See: https://developer.apple.com/documentation/security/hardened-runtime -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- APP SANDBOX: Enable the capabilities your application needs, and use
         SwiftPythonWorker-sandbox.entitlements for the inherited helper.
         See: https://developer.apple.com/documentation/xcode/embedding-a-helper-tool-in-a-sandboxed-app -->
    <!-- <key>com.apple.security.app-sandbox</key><true/> -->
    <!-- <key>com.apple.security.network.client</key><true/> -->
    <!-- <key>com.apple.security.files.user-selected.read-write</key><true/> -->
</dict>
</plist>
