<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandboxed-parent helper template. The nested probe carries exactly
         sandbox inheritance; microphone and every other capability belong
         to the parent application. Embed, relocate, and same-team-sign
         Python instead of adding hardened-runtime exceptions here. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
